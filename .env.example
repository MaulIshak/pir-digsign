# ==============================================================================
# PIR-DIGSIGN - Aplikasi Tanda Tangan Digital (PAdES + QR Verifikasi)
# Salin file ini menjadi .env sebelum menjalankan docker compose / aplikasi
# ==============================================================================

# --- Lingkungan ---
APP_ENV=development
APP_NAME=PirDigSign
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Keamanan & JWT ---
# WAJIB ganti dengan string acak >= 32 karakter untuk produksi!
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_AT_LEAST_32_CHARS_LONG_DEV_ONLY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Batas upload file PDF (default 20 MB)
MAX_PDF_SIZE_BYTES=20971520
# Rate limiting (format slowapi, contoh: 10/minute)
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGN=20/minute
RATE_LIMIT_VERIFY=60/minute

# --- Database PostgreSQL ---
POSTGRES_USER=digsign
POSTGRES_PASSWORD=digsign_secret_dev
POSTGRES_DB=digsign_db
DATABASE_URL=postgresql+psycopg2://digsign:digsign_secret_dev@postgres:5432/digsign_db

# --- Penyimpanan File (Storage) ---
# Opsi: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/app/storage
# Opsional: Fernet key base64 (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Kosongkan di dev jika tidak ingin enkripsi at-rest; WAJIB diisi di produksi
STORAGE_ENCRYPTION_KEY=

# Konfigurasi S3 / MinIO (jika STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=digsign-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-3

# --- Kriptografi & Signer Provider (pyHanko) ---
# Opsi: self_signed | kms_hsm | psre_indonesia
SIGNER_PROVIDER=self_signed
# Direktori terproteksi (di luar DB!) untuk key & sertifikat dev
CERT_DIR=/app/certs
CERT_KEY_PASSPHRASE=dev-cert-passphrase-change-me
CERT_COMMON_NAME=PirDigSign Local CA (Development Self-Signed)
CERT_ORG_NAME=PirDigSign Dev

# Opsional: RFC 3161 Timestamp Authority (TSA)
# Contoh publik: http://timestamp.digicert.com atau https://freetsa.org/tsr
# Kosongkan jika lingkungan offline
TSA_URL=

# Placeholder integrasi PSrE Indonesia (Privy / Peruri / VIDA / BSrE)
PSRE_VENDOR=bsre
PSRE_API_URL=
PSRE_API_KEY=
PSRE_CLIENT_ID=

# --- Email Provider ---
# Opsi: console (cetak link di log backend) | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@digsign.local
SMTP_USE_TLS=true

# --- Produksi & Cloudflare Tunnel (dipakai oleh docker-compose.prod.yml) ---
APP_DOMAIN=sign.domainanda.com
CLOUDFLARE_TUNNEL_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
